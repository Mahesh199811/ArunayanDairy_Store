# Copy this file to .env and replace the example values.
MONGODB_URI='mongodb+srv://<user>:<password>@<cluster>/arunayan_users?retryWrites=true&w=majority'
JWT_SECRET_BASE64='REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32'

# Optional bootstrap administrator. Set both values or leave both empty.
BOOTSTRAP_ADMIN_EMAIL=''
BOOTSTRAP_ADMIN_PASSWORD=''
BOOTSTRAP_ADMIN_NAME='Store Administrator'

FRONTEND_ORIGIN='http://localhost:5173'
SERVER_PORT='8081'
JWT_EXPIRATION='PT15M'
